classDiagram
    %% PawPal+ final design (matches pawpal_system.py)

    class Task {
        +str description
        +str time
        +str frequency
        +bool completed
        +date due_date
        +mark_complete() void
        +next_occurrence() Task
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) void
        +task_count() int
    }

    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet) void
        +all_tasks() list
    }

    class Scheduler {
        +Owner owner
        +todays_schedule() list
        +sort_by_time(pairs) list
        +filter_tasks(pet_name, completed) list
        +complete_task(pet, task) Task
        +detect_conflicts() list~str~
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : reads
    Scheduler ..> Task : creates on recurrence
